# ─── Core ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Admin Seed (first-run only — creates admin account if none exists) ─────────
ADMIN_EMAIL=admin@roadreadynetwork.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
JWT_EXPIRES_IN=30d

# ─── AI / Groq (free tier — Llama 3.3) ──────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here

# ─── Translation / DeepL ───────────────────────────────────────────────────────
# Get from: https://www.deepl.com/pro-api  (free tier available)
DEEPL_API_KEY=your-deepl-api-key-here

# ─── Stripe (Billing / Subscriptions) ─────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
# Get from: Stripe Dashboard → Products → your monthly plan → Price ID
STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
# Get from: Stripe Dashboard → Products → your annual plan → Price ID
STRIPE_PRICE_ANNUAL=price_your_annual_price_id
# Get from: Stripe Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── Cloudinary (Document / Image Uploads) ─────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── EIA (Diesel Fuel Prices) ──────────────────────────────────────────────────
# Get from: https://www.eia.gov/opendata/  (free, instant approval)
EIA_API_KEY=your-eia-api-key-here

# ─── Email (Resend — transactional email) ──────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=CST App <noreply@yourdomain.com>

# ─── SMTP (fallback email / Gmail app password) ────────────────────────────────
# Gmail: Enable 2FA → https://myaccount.google.com/apppasswords → generate app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# ─── Google Sign-In (verifies ID tokens from @react-native-google-signin) ──────
# Must match the Web and iOS OAuth Client IDs from Google Cloud Console → Clients
# (cst-mobile/src/constants/googleAuth.ts has the same values for the app side)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# ─── Twilio (Phone / SMS OTP Login) ────────────────────────────────────────────
# Get from: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get from: Twilio Console → Account Info → Auth Token
TWILIO_AUTH_TOKEN=your_auth_token_here
# Get from: Twilio Console → Phone Numbers (must be SMS-capable)
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ─── TomTom (Geocoding — partner listing map pins) ─────────────────────────────
# Required for geocoding partner addresses to lat/lng so they appear on the map.
# Without this, all listings will have no map pin and won't show on the dashboard map.
# Get from: https://developer.tomtom.com → My Apps → Create API Key (free tier available)
TOMTOM_API_KEY=your_tomtom_api_key_here

# ─── Sentry (Error Monitoring — optional) ──────────────────────────────────────
# Get from: https://sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN=https://your-key@oXXXXX.ingest.sentry.io/XXXXXXX

# ─── LiveKit (Go Live / video broadcast) ───────────────────────────────────────
# Get from: https://cloud.livekit.io → your project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ─── Internal API (server-to-server calls from ca_website's admin) ─────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match CST_BACKEND_API_KEY in ca_website/server/.env
INTERNAL_API_KEY=your-internal-shared-secret-here
