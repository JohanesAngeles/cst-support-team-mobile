{
  "expo": {
    "name": "Road Ready Network",
    "slug": "cst-mobile",
    "version": "1.1.1",
    "scheme": "cst",
    "orientation": "portrait",
    "icon": "./assets/icon-road-ready.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/road_ready_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cst.driver",
      "buildNumber": "13",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Road Ready Network uses your location to find nearby fuel stops, truck stops, rest areas, and emergency services.",
        "NSDocumentPickerUsageDescription": "Road Ready Network needs access to your files to store documents in your Document Vault.",
        "NSPhotoLibraryUsageDescription": "Road Ready Network needs access to your photos to attach images to documents and update your profile picture.",
        "NSCameraUsageDescription": "Road Ready Network uses the camera to let you take a profile photo.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3A5C"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDDejKfy4sA8IR3UQ0R2xDUUDQi8ApNYK0"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.cst.driver",
      "versionCode": 9,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withModularHeaders",
      "expo-apple-authentication",
      "expo-local-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.663100579676-4epb15balm8ehefu2s8cuqd2d2v05djd"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E74C3C",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Road Ready Network uses your location to find nearby fuel stops, truck stops, and emergency services."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Road Ready Network needs access to your photos to update your profile picture.",
          "cameraPermission": "Road Ready Network uses the camera to take a profile photo."
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "@sentry/react-native",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "4911ea0c-485c-45a3-9902-a721a851155c"
      }
    },
    "owner": "ca_schooloftrucking"
  }
}
