# ============================================================
# CST Driver — Environment Variables
# Copy this file to .env and fill in all values before building.
# EXPO_PUBLIC_* vars are bundled into the app at build time.
# ============================================================


# ── Crash Reporting (Sentry) ─────────────────────────────────
# Create a project at https://sentry.io → React Native
# DSN is on: Settings → Projects → <your project> → Client Keys
EXPO_PUBLIC_SENTRY_DSN=https://your-key@oXXXXX.ingest.sentry.io/XXXXXXX


# ── Analytics (PostHog) ──────────────────────────────────────
# Create a project at https://us.posthog.com
# API key is on: Project Settings → Project API Key
EXPO_PUBLIC_POSTHOG_KEY=phc_your_posthog_key_here


# ── App Store URLs ───────────────────────────────────────────
# Set this AFTER your app is approved and live on the App Store.
# Find it in App Store Connect → App Information → Apple ID (numeric)
# Example: 6743210000
EXPO_PUBLIC_IOS_APP_ID=


# ── Google OAuth ─────────────────────────────────────────────
# Create OAuth 2.0 credentials at https://console.cloud.google.com
# APIs & Services → Credentials → Create Credentials → OAuth Client ID
#
# Web client (used for token exchange on the backend):
#   Application type: Web application
#   Authorized redirect URIs: add your Heroku backend URL + /api/auth/google/callback
#
# iOS client:
#   Application type: iOS
#   Bundle ID: com.cst.driver
#
# Android client:
#   Application type: Android
#   Package name: com.cst.driver
#   SHA-1: run `eas credentials` to get your keystore SHA-1
#
# After creating, paste the values in src/constants/googleAuth.ts
# (These are not EXPO_PUBLIC_ vars — they live directly in that file)


# ── EAS / Expo ───────────────────────────────────────────────
# Run `eas init` in the cst-mobile directory to auto-populate:
#   - extra.eas.projectId in app.json
#   - owner in app.json
# These are stored directly in app.json, not here.


# ── Apple Store Submission ───────────────────────────────────
# These go directly in eas.json → submit.production.ios
# (not env vars — eas.json reads them directly)
#
#   appleId:     your Apple ID email (e.g. you@example.com)
#   ascAppId:    App Store Connect numeric App ID
#                (App Store Connect → App Information → Apple ID)
#   appleTeamId: 10-character Team ID
#                (developer.apple.com → Account → Membership)


# ── Google Play Submission ───────────────────────────────────
# Download a service account JSON key from:
#   Google Play Console → Setup → API access → Service accounts
# Save it as google-play-key.json in the cst-mobile root.
# The path is already configured in eas.json.


# ── TomTom (Reverse Geocoding — nearby partner search) ───────────────────────
# Used to convert the driver's GPS coordinates to city/state for nearby search.
# Get from: https://developer.tomtom.com → My Apps → API Key
EXPO_PUBLIC_TOMTOM_API_KEY=your_tomtom_api_key_here
